# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: leave blank and SMS is logged as 'simulated' instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: send every real SMS to this number instead (e.g. your own, verified in Twilio).
SMS_REDIRECT_TO=
# Shared secret the agent sends to the tool endpoints. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If blank, the API makes a random one at startup (fine for a single process).
TOOLS_API_TOKEN=
# Token the dashboard's server sends to the dashboard endpoints. Must match web/.env.local.
DASHBOARD_API_TOKEN=
# Optional /chat rate limits (defaults shown).
# CHAT_RATE_PER_MINUTE=10        per customer IP
# CHAT_RATE_PER_DAY=100          per customer IP
# CHAT_GLOBAL_PER_DAY=2000       everyone together, including staff; bounds model spend
# Postgres password. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Only applied when the database is first created; to change it later, see the README.
POSTGRES_PASSWORD=
# For running the API or tests outside Docker (compose sets its own for the container).
DATABASE_URL=postgresql://outage:<POSTGRES_PASSWORD>@localhost:5432/outage
# Set to true to serve interactive API docs at /docs (off by default).
ENABLE_API_DOCS=
