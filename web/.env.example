# Copy to .env.local and fill in. Never commit .env.local.
# Where /api/* is forwarded (the FastAPI API).
API_URL=http://localhost:8000
# Must match DASHBOARD_API_TOKEN in the API's .env.
DASHBOARD_API_TOKEN=
# The staff account for the dashboard login.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Signs session cookies; at least 32 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
